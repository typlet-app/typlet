{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typlet",
  "mainBinaryName": "typlet-editor",
  "identifier": "io.github.typlet-app.typlet",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "web/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Typlet",
        "width": 1120,
        "height": 740,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4NUFBNkYzRDg1QUM5NzEKUldSeHlWclk4NlphT0lxcmZPYzdVM2xNVjRmUVlpc1g1YkN4ZENNNVIzTncvTFBmVjNsRUt1YVcK",
      "endpoints": [
        "https://github.com/typlet-app/typlet/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
