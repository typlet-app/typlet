// The tray icon and its menu: the main entry point of the background program.

export component TrayIcon inherits SystemTrayIcon {
    in property <bool> paused;
    in-out property <bool> autostart;
    in property <string> search-shortcut;
    // A newer version found by the daily check, or empty.
    in property <string> update-version;
    // A milestone just reached: 0 none, 1 snippets inserted, 2 hours of
    // typing saved, 3 days in a row; and its number.
    in property <int> milestone-kind;
    in property <int> milestone-value;

    callback search();
    callback new-snippet();
    callback open-editor();
    callback install-update();
    callback open-stats();
    callback open-folder();
    callback toggle-pause();
    callback toggle-autostart();
    callback setup();
    callback diagnostics();
    callback help();
    callback donate();
    callback quit();

    icon: root.paused ? @image-url("images/tray-paused.png") : @image-url("images/tray.png");
    title: "Typlet";
    tooltip: root.paused ? @tr("Typlet is paused") : @tr("Typlet is active");
    clicked => {
        root.search();
    }

    Menu {
        if root.update-version != "": MenuItem {
            title: @tr("Install update {}", root.update-version);
            activated => {
                root.install-update();
            }
        }

        if root.update-version != "": MenuSeparator { }

        if root.milestone-kind != 0: MenuItem {
            title: root.milestone-kind == 1 ? @tr("🎉 {} snippets inserted – see your statistics", root.milestone-value)
                : root.milestone-kind == 2 && root.milestone-value == 1 ? @tr("🎉 One hour of typing saved – see your statistics")
                : root.milestone-kind == 2 ? @tr("🎉 {} hours of typing saved – see your statistics", root.milestone-value)
                : @tr("🔥 {} days in a row – see your statistics", root.milestone-value);
            activated => {
                root.open-stats();
            }
        }

        if root.milestone-kind != 0: MenuSeparator { }

        MenuItem {
            title: root.search-shortcut == "" ? @tr("Search snippets…") : @tr("Search snippets…  ({})", root.search-shortcut);
            activated => {
                root.search();
            }
        }

        MenuItem {
            title: @tr("New snippet…");
            activated => {
                root.new-snippet();
            }
        }

        MenuItem {
            title: @tr("Open editor");
            activated => {
                root.open-editor();
            }
        }

        MenuItem {
            title: @tr("Open snippet folder");
            activated => {
                root.open-folder();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: root.paused ? @tr("Resume Typlet") : @tr("Pause Typlet");
            activated => {
                root.toggle-pause();
            }
        }

        MenuItem {
            title: @tr("Start with the computer");
            checkable: true;
            checked <=> root.autostart;
            activated => {
                root.toggle-autostart();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: @tr("Set up and test…");
            activated => {
                root.setup();
            }
        }

        MenuItem {
            title: @tr("Diagnostics…");
            activated => {
                root.diagnostics();
            }
        }

        MenuItem {
            title: @tr("Help");
            activated => {
                root.help();
            }
        }

        MenuItem {
            title: @tr("Support Typlet ❤️");
            activated => {
                root.donate();
            }
        }

        MenuSeparator { }

        MenuItem {
            title: @tr("Quit Typlet");
            activated => {
                root.quit();
            }
        }
    }
}
