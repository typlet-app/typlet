// SPDX-License-Identifier: GPL-3.0-or-later
// The set-up assistant: welcome, permission check, a test field to try the
// first snippet and the final options.

import { Button, TextEdit, Switch } from "std-widgets.slint";
import { Theme, TriggerChip, Logo, StatusLine } from "theme.slint";

export struct ExampleItem {
    trigger: string,
    label: string,
}

component PageDots inherits HorizontalLayout {
    in property <int> count;
    in property <int> current;
    alignment: center;
    spacing: 6px;
    for i in root.count: Rectangle {
        width: i == root.current ? 18px : 6px;
        height: 6px;
        border-radius: 3px;
        background: i == root.current ? Theme.brand : Theme.border;
        animate width { duration: 150ms; }
    }
}

export component SetupWindow inherits Window {
    in-out property <int> page: 0;
    in property <[ExampleItem]> examples;
    in property <bool> keyboard-ok;
    in property <bool> typing-ok;
    in property <bool> focus-ok;
    in property <string> problems;
    in property <bool> linux;
    in property <string> test-trigger;
    in property <string> search-shortcut;
    in-out property <bool> autostart;
    in-out property <string> test-text;

    callback recheck();
    callback toggle-autostart();
    callback open-editor();
    callback finish();

    in property <bool> test-passed;
    callback test-changed(text: string);
    changed test-text => {
        root.test-changed(root.test-text);
    }
    out property <bool> checks-ok: root.keyboard-ok && root.typing-ok;

    title: @tr("Welcome to Typlet");
    icon: @image-url("images/icon.png");
    preferred-width: 560px;
    min-width: 480px;
    preferred-height: 520px;
    min-height: 460px;
    background: Theme.surface;

    VerticalLayout {
        padding: Theme.padding-large;
        spacing: Theme.padding;

        // Page 1: welcome.
        if root.page == 0: VerticalLayout {
            spacing: Theme.padding;
            vertical-stretch: 1;
            HorizontalLayout {
                spacing: 14px;
                Logo {
                    width: 48px;
                    height: 48px;
                }

                VerticalLayout {
                    alignment: center;
                    Text {
                        text: @tr("Welcome to Typlet");
                        color: Theme.text;
                        font-size: Theme.font-hero;
                        font-weight: 700;
                    }
                }
            }

            Text {
                text: @tr("Typlet writes text for you. Type a short trigger such as {} anywhere – in emails, chats or documents – and Typlet replaces it with the full text.", root.test-trigger != "" ? root.test-trigger : ":mfg");
                color: Theme.text;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            Text {
                text: @tr("To get you started, Typlet created these example snippets:");
                color: Theme.muted;
                font-size: Theme.font-body;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 6px;
                for example in root.examples: HorizontalLayout {
                    spacing: Theme.gap;
                    TriggerChip {
                        text: example.trigger;
                        width: 80px;
                    }

                    Text {
                        text: example.label;
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        // Page 2: permissions.
        if root.page == 1: VerticalLayout {
            spacing: Theme.padding;
            vertical-stretch: 1;
            Text {
                text: @tr("Checking your computer");
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 600;
            }

            StatusLine {
                ok: root.keyboard-ok;
                title: root.keyboard-ok ? @tr("Typlet can see what you type.") : @tr("Typlet cannot read the keyboard yet.");
            }

            StatusLine {
                ok: root.typing-ok;
                title: root.typing-ok ? @tr("Typlet can insert text.") : @tr("Typlet cannot type into other apps yet.");
            }

            StatusLine {
                ok: root.focus-ok;
                title: root.focus-ok ? @tr("Typlet recognises the active app.") : @tr("Typlet cannot recognise the active app on this desktop.");
                detail: root.focus-ok ? "" : @tr("Not a problem: snippets still work, only app-specific rules are unavailable.");
            }

            if root.problems != "": VerticalLayout {
                spacing: 6px;
                vertical-stretch: 1;
                Text {
                    text: root.linux ? @tr("Run these commands once in a terminal, then log out and back in:") : @tr("What to do:");
                    color: Theme.text;
                    wrap: word-wrap;
                }

                TextEdit {
                    text: root.problems;
                    read-only: true;
                    font-family: "monospace";
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }

                HorizontalLayout {
                    alignment: start;
                    Button {
                        text: @tr("Check again");
                        clicked => {
                            root.recheck();
                        }
                    }
                }
            }

            if root.problems == "": Rectangle {
                vertical-stretch: 1;
            }
        }

        // Page 3: try it.
        if root.page == 2: VerticalLayout {
            spacing: Theme.padding;
            vertical-stretch: 1;
            Text {
                text: @tr("Try it");
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 600;
            }

            HorizontalLayout {
                spacing: Theme.gap;
                alignment: start;
                Text {
                    text: @tr("Click into the field and type");
                    color: Theme.text;
                    vertical-alignment: center;
                }

                TriggerChip {
                    text: root.test-trigger;
                }
            }

            TextEdit {
                text <=> root.test-text;
                wrap: word-wrap;
                height: 120px;
                placeholder-text: @tr("Type here…");
            }

            Text {
                text: root.test-passed ? @tr("✓ It works! Typlet replaced the trigger with the full text.") : root.checks-ok ? @tr("The text appears as soon as you finish typing the trigger.") : @tr("This only works once the checks on the previous page pass.");
                color: root.test-passed ? Theme.success : Theme.muted;
                font-size: Theme.font-body;
                font-weight: root.test-passed ? 600 : 400;
                wrap: word-wrap;
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        // Page 4: done.
        if root.page == 3: VerticalLayout {
            spacing: Theme.padding;
            vertical-stretch: 1;
            Text {
                text: @tr("You are ready");
                color: Theme.text;
                font-size: Theme.font-title;
                font-weight: 600;
            }

            Text {
                text: @tr("Typlet keeps running in the background. You find it as an icon in the system tray, next to the clock.");
                color: Theme.text;
                wrap: word-wrap;
            }

            if root.search-shortcut != "": HorizontalLayout {
                spacing: Theme.gap;
                alignment: start;
                Text {
                    text: @tr("Search all snippets with");
                    color: Theme.text;
                    vertical-alignment: center;
                }

                TriggerChip {
                    text: root.search-shortcut;
                }
            }

            Text {
                text: @tr("Create your own snippets in the editor – with formatting, today's date or fill-in forms.");
                color: Theme.text;
                wrap: word-wrap;
            }

            Switch {
                text: @tr("Start Typlet when the computer starts");
                checked <=> root.autostart;
                toggled => {
                    root.toggle-autostart();
                }
            }

            Rectangle {
                vertical-stretch: 1;
            }
        }

        PageDots {
            count: 4;
            current: root.page;
        }

        HorizontalLayout {
            spacing: Theme.gap;
            if root.page > 0: Button {
                text: @tr("Back");
                clicked => {
                    root.page -= 1;
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            if root.page == 3: Button {
                text: @tr("Open editor");
                clicked => {
                    root.open-editor();
                    root.finish();
                }
            }

            if root.page < 3: Button {
                text: root.page == 1 && !root.checks-ok ? @tr("Skip") : @tr("Next");
                primary: true;
                clicked => {
                    if root.page == 0 {
                        root.recheck();
                    }
                    root.page += 1;
                }
            }

            if root.page == 3: Button {
                text: @tr("Finish");
                primary: true;
                clicked => {
                    root.finish();
                }
            }
        }
    }
}
